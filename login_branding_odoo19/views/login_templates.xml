<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Split-screen layout: branded panel on the left, sign-in form on the right.
         All content is read from the login.branding singleton (sudo, because the
         login page is served to the public user). -->
    <!-- priority="30": the stock `website` module ships its own inherit_id="web.login_layout"
         view at priority 20 that replaces the ENTIRE outer <t t-call="web.frontend_layout">
         node with <t t-call="website.layout"> (full site chrome), discarding anything nested
         inside it — including a lower-priority view's changes. Targeting the same outer `t`
         node (instead of the inner container div) at a priority higher than website's means
         this view always runs last and wins, regardless of whether `website` is installed or
         install order, with no dependency on `website` needed. See website/views/website_templates.xml
         (template id="login_layout", inherit_id="web.login_layout", priority="20") for the
         view this is guarding against. -->
    <template id="login_branding_layout" inherit_id="web.login_layout" priority="30">
        <xpath expr="t" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'bg-100'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <t t-set="lb" t-value="request.env['login.branding'].sudo().search([], limit=1)"/>
                <!-- Served by Odoo's own generic /web/image controller (public,
                     read-only access granted to login.branding in
                     security/ir.model.access.csv) instead of a custom
                     controller route, so no reverse-proxy path needs to know
                     about this module specifically. -->
                <t t-set="logo_src"
                   t-value="(lb and lb.logo) and ('/web/image/login.branding/%s/logo' % lb.id) or '/login_branding/static/src/img/logo.png'"/>

                <!-- Admin-configurable colors, applied as CSS variables. Later in the
                     document than the stylesheet, so these overrides win. -->
                <style>
                    .lb_login{
                        --lb-navy: <t t-out="(lb and lb.gradient_start) or '#0d1b3e'"/>;
                        --lb-grad-end: <t t-out="(lb and lb.gradient_end) or '#00aeef'"/>;
                        --lb-blue: <t t-out="(lb and lb.primary_color) or '#2563eb'"/>;
                    }
                </style>

                <div class="lb_login">

                    <aside class="lb_login_brand">
                        <div class="lb_login_brand_bg"/>
                        <div class="lb_login_brand_body">
                            <img t-att-src="logo_src" alt="Logo" width="200"/>

                            <h1 class="lb_login_title" t-out="(lb and lb.brand_title) or 'Welcome'"/>
                            <p class="lb_login_subtitle" t-if="lb and lb.brand_subtitle" t-out="lb.brand_subtitle"/>

                            <ul class="lb_login_features" t-if="lb and lb.show_features and lb.feature_ids">
                                <li t-foreach="lb.feature_ids" t-as="feat">
                                    <span class="lb_check"><i class="fa fa-check" role="img" aria-hidden="true"/></span>
                                    <span t-out="feat.name"/>
                                </li>
                            </ul>
                        </div>
                    </aside>

                    <main class="lb_login_panel">
                        <div class="lb_login_box o_database_list">
                            <img t-att-src="logo_src" alt="Logo" width="200"/>
                            <h2 class="lb_login_heading" t-if="lb and lb.form_heading" t-out="lb.form_heading"/>

                            <t t-out="0"/>

                            <div class="lb_login_footer my-0" t-if="not disable_footer">
                                <t t-if="not disable_database_manager">
                                    <a href="/web/database/manager">Manage Databases</a>
                                </t>
                            </div>
                        </div>
                    </main>

                </div>
            </t>
        </xpath>
    </template>

    <!-- Field labels, password reveal toggle and submit button restyling -->
    <template id="login_branding_form" inherit_id="web.login">

        <xpath expr="//div[hasclass('field-login')]" position="replace">
            <div class="mb-3 field-login">
                <label for="login" class="form-label">Email Address</label>
                <input type="text" placeholder="Email Address" name="login" t-att-value="login" id="login"
                       class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
            </div>
        </xpath>

        <!-- Odoo 19 wraps the label and the input-group in div.o_caps_lock_warning
             (the caps-lock hint hooks onto that class), so replace the whole block
             rather than just the input's parent, otherwise the label is duplicated. -->
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="replace">
            <div class="mb-3 field-password o_caps_lock_warning">
                <label for="password" class="form-label">Password</label>
                <div class="lb_password_wrap">
                    <input type="password" placeholder="Password" name="password" id="password"
                           class="form-control" required="required" autocomplete="current-password"
                           t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                    <button type="button" class="lb_password_toggle" aria-label="Show password">
                        <i class="fa fa-eye" role="img" aria-hidden="true"/>
                    </button>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('oe_login_buttons')]/button" position="replace">
            <button type="submit" class="btn btn-primary lb_signin_btn">Sign In</button>
        </xpath>

    </template>

</odoo>
