<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Browser-tab icon for every Odoo page. web.layout is the base <head> shared
         by the backend web client, the login page and (via website.layout) every
         website/eLearning page, so overriding its favicon link here covers them all.
         The href is forced unconditionally so it also wins over the per-website
         favicon that `website` passes in as x_icon. -->
    <template id="login_branding_favicon" inherit_id="web.layout" priority="99">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="type">image/png</attribute>
            <attribute name="t-att-href">'/login_branding/static/src/img/logo.png'</attribute>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="after">
            <link rel="apple-touch-icon" href="/login_branding/static/src/img/logo.png"/>
        </xpath>
    </template>

</odoo>
