<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: content is user-editable from the backend, so edits survive
         module upgrades. Change the wording in Settings > Login Page Design. -->
    <data noupdate="1">

        <record id="login_branding_default" model="login.branding">
            <field name="brand_title">Welcome Back</field>
            <field name="brand_subtitle">Sign in to access your workspace and pick up right where you left off.</field>
            <field name="show_features" eval="True"/>
            <field name="gradient_start">#ffffff</field>
            <field name="gradient_end">#333333</field>
            <field name="primary_color">#2563eb</field>
        </record>

        <record id="feature_1" model="login.branding.feature">
            <field name="config_id" ref="login_branding_default"/>
            <field name="sequence">10</field>
            <field name="name">Everything your team needs in one place</field>
        </record>

        <record id="feature_2" model="login.branding.feature">
            <field name="config_id" ref="login_branding_default"/>
            <field name="sequence">20</field>
            <field name="name">Real-time insight into what matters</field>
        </record>

        <record id="feature_3" model="login.branding.feature">
            <field name="config_id" ref="login_branding_default"/>
            <field name="sequence">30</field>
            <field name="name">Secure access, tailored to your role</field>
        </record>

    </data>
</odoo>
